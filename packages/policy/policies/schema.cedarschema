// The vocabulary policies are written in. Requests are validated against it,
// so a tool that is not listed here cannot be authorised at all.

entity Agent;

entity Ticket = {
  category: String,
  // The most this ticket's refunds may total without staff approval.
  approvalLimitCents: Long,
  // How many whole days after a payment a refund on request is allowed.
  refundWindowDays: Long,
  // The most the agent may refund for this ticket's company in 24 hours
  // without staff approval.
  dailyRefundCapCents: Long,
};

type Common = {
  // Set by staff to stop the agent from acting, per tenant.
  agentPaused: Bool,
};

action list_invoices, list_subscriptions, search_help_center, get_entitlement appliesTo {
  principal: Agent,
  resource: Ticket,
  context: Common,
};

// Everything below `reason` is looked up in the billing records by the policy
// layer itself. None of it is taken from the model's word.
action create_refund appliesTo {
  principal: Agent,
  resource: Ticket,
  context: {
    agentPaused: Bool,
    amountCents: Long,
    reason: String,
    // Refunds this ticket has already paid out.
    ticketRefundedCents: Long,
    // Refunds the agent made for this company in the last 24 hours, from the
    // system's own record of them.
    tenantRefundedTodayCents: Long,
    // True only when staff approved this exact call.
    approved: Bool,
    // The payment exists on this customer's account.
    paymentFound: Bool,
    daysSincePayment: Long,
    // The full amount of the payment being refunded.
    paymentAmountCents: Long,
    // An earlier successful payment exists for the same invoice.
    isLaterDuplicate: Bool,
    // A payment on the invoice is under a bank dispute.
    invoiceDisputed: Bool,
    // The customer had a refund on request in the last 365 days.
    goodwillUsed: Bool,
  },
};

action change_plan appliesTo {
  principal: Agent,
  resource: Ticket,
  context: {
    agentPaused: Bool,
    // The number of seats after the change.
    seats: Long,
  },
};
