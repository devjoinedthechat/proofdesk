{
  "name": "proofdesk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm check:secrets && pnpm lint && pnpm typecheck && pnpm test",
    "stack:up": "docker compose -f infra/compose/compose.yaml up --detach --wait",
    "stack:down": "docker compose -f infra/compose/compose.yaml down",
    "stack:reset": "docker compose -f infra/compose/compose.yaml down --volumes",
    "test:unit": "vitest run --project unit",
    "check:secrets": "scripts/check-secrets.sh --all",
    "prepare": "git config core.hooksPath .githooks || true",
    "evals": "node --env-file-if-exists=.env packages/evals/src/cli.ts",
    "evals:report": "node packages/evals/src/report.ts",
    "local:up": "scripts/local.sh up",
    "local:demo": "scripts/local.sh demo",
    "local:logs": "scripts/local.sh logs",
    "local:down": "scripts/local.sh down",
    "local:reset": "scripts/local.sh reset",
    "evals:capture": "node --env-file-if-exists=.env packages/evals/src/capture-cli.ts",
    "local:smoke": "scripts/smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@proofdesk/db": "workspace:*",
    "@proofdesk/identity": "workspace:*",
    "@proofdesk/simulator": "workspace:*",
    "@proofdesk/worker": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
