{
  "name": "proofdesk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "stack:up": "docker compose -f infra/compose/compose.yaml up --detach --wait",
    "stack:down": "docker compose -f infra/compose/compose.yaml down",
    "stack:reset": "docker compose -f infra/compose/compose.yaml down --volumes",
    "test:unit": "vitest run --project unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@proofdesk/db": "workspace:*",
    "@proofdesk/simulator": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
