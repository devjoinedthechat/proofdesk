# Copy to .env. Everything here is optional: without a key the local stack
# runs on a scripted stand-in for the model and spends nothing.

# With a key, the agent is Claude. Also needed for `pnpm evals`.
ANTHROPIC_API_KEY=

# The model the agent uses when a key is set.
# MODEL=claude-sonnet-5-5

# Where the watchdog posts its alerts, such as a chat channel's webhook.
# ALERT_WEBHOOK_URL=

# Host ports, if the defaults are taken on this machine.
# PORTAL_PORT=3000
# KEYCLOAK_PORT=8080
# POSTGRES_PORT=5432
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233
# GRAFANA_PORT=3001
# PHOENIX_PORT=6006
